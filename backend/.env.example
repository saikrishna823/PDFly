# Copy to .env for local overrides. All values are optional.

# development | production  (production hides /docs and /openapi.json)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call the API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:4200,https://saikrishna823.github.io

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

# Per-IP fixed-window limit for processing endpoints (single instance only).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
